        margin: 0;
        font-size: 1.2rem;
        color: #1a1a1a;
      }

      .footer-links {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
      }


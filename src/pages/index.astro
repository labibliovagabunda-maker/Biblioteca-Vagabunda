---
import fs from 'node:fs';
import path from 'node:path';

const filePath = path.resolve('src/pages/Catálogo Biblioteca Vagabunda - Disponibles.csv');
const fileContent = fs.readFileSync(filePath, 'utf-8');
const lines = fileContent.split('\n').filter(Boolean);

const libros = lines.slice(1).map(line => {
  const values = line.split(',');
  const codigo = values[0] ? values[0].trim() : '';
  const estadoTexto = values[8] ? values[8].trim() : 'Disponible';
  
  return {
    codigo: codigo,
    isbn: values[1] ? values[1].trim() : '',
    titulo: values[2] ? values[2].trim() : '',
    autorx: values[3] ? values[3].trim() : '',
    anio: values[4] ? values[4].trim() : '',
    editorial: values[5] ? values[5].trim() : '',
    lugar: values[6] ? values[6].trim() : '',
    tipo: values[7] ? values[7].trim() : 'Libro',
    estado: estadoTexto,
    esPrestado: estadoTexto.toLowerCase().includes('prestamo') || estadoTexto.toLowerCase().includes('préstamo') || estadoTexto.toLowerCase().includes('prestado'),
    foto: `/portadas/${codigo}.png`
  };
});
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>La Biblioteca Vagabunda | Catálogo</title>
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <style is:global>
      :root {
        --bg-color: #fcfbfa;
        --card-bg: #ffffff;
        --text-main: #2c2c2c;
        --text-muted: #666666;
        --accent: #e67e22;
        --border: #f0ede6;
      }

      body {
        background-color: #f8f9fa;
        background-image: url('/vagabundeo.png');
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        flex: 1;
        padding-bottom: 3rem;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        text-align: center;
      }

      .logo {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        border: 2px solid #fff;
      }

      .header-text h1 {
        margin: 0;
        font-size: 2rem;
        color: #1a1a1a;
        letter-spacing: -0.5px;
      }

